#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
void solve(){
    int n; cin>>n;
    int odd=0, eoq=0, eeq=0;
    for(int ctr=0;ctr<n;ctr++){
        int curr; cin>>curr;
        if(curr&1) odd++;
        else{
            int q=curr/2;
            if(q&1) eoq++;
            else eeq++;
        }
    }
    cout<<max(odd,max(eoq,eeq))<<endl;

}
int main(){
    int t; cin>>t;
    while(t--){
        solve();
    }
}
